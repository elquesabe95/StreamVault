# TMDB API Key (get your free key at https://www.themoviedb.org/settings/api)
TMDB_API_KEY=your_tmdb_api_key_here

# Ads Configuration (optional)
# ADS_ENABLED=false  # Set to "false" to disable pre-roll ads
# CUSTOM_ADS=[{"id":"my-ad","title":"Mi Anuncio","description":"Descripcion del anuncio","clickUrl":"https://mysite.com","duration":5,"active":true,"priority":1}]

# ── Scraping (tuned per host; see render.yaml for the Render values) ──────────
# Total time one provider gets to scrape AND resolve. 18s fits Vercel's 25s
# function cap; Render has no cap but ~8s per outbound hop, so it needs more.
# PROVIDER_BUDGET_MS=55000
# Grace period for extra mirrors after the first playable stream is found.
# EARLY_EXIT_GRACE_MS=6000
# Providers scraping at once. Low-CPU hosts need 1-2; they starve each other
# otherwise and every one of them misses the budget.
# PROVIDER_CONCURRENCY=2
# PROXY_TIMEOUT_MS=10000
# DIRECT_TIMEOUT_MS=6000
# Cloudflare Worker proxy (deploy worker-proxy.js). Extras are comma-separated.
# PROXY_WORKER_URL=https://your-worker.workers.dev
# PROXY_EXTRA_URLS=
# "1" tries the target site directly before the proxy — only worth it where the
# host's IPs aren't blocked. Check with /api/v1/debug?action=net first.
# SCRAPER_DIRECT_FIRST=0
# Cap on the embed proof-of-work solver, which shares this single Node process.
# POW_BUDGET_MS=8000
