generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Channel {
  id        String   @id @default(cuid())
  name      String
  url       String
  logo      String?
  category  String?
  country   String?
  provider  String
  headers   String?  // JSON stringified
  updatedAt DateTime @updatedAt
}

model ScrapeCache {
  id        String   @id @default(cuid())
  tmdbId    String
  type      String   // movie, tv
  season    Int?
  episode   Int?
  results   String   // JSON stringified sources
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([tmdbId, type, season, episode])
}